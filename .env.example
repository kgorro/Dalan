# Copy to .env and edit.
# Local model. qwen2.5:3b-instruct runs on a 4 GB RAM CPU VPS; use qwen2.5:7b-instruct with 8 GB or more.
# When sharing PoultryBot's model, use the same name as in PoultryBot's .env.
LLM_MODEL=qwen2.5:3b-instruct
# Error budget for verified answers (lower = more cautious, more LLM calls)
DALAN_EPS=0.05
# Port the bot listens on. 8001 so it can run next to PoultryBot on 8000.
BOT_PORT=8001
# auto: share PoultryBot's model if it is running on this VPS, otherwise run our own. yes or no to force.
SHARE_LLM=auto
# For HTTPS with Caddy: a domain whose DNS A record points to this VPS (see docs/DEPLOY.md if PoultryBot also uses HTTPS)
DOMAIN=
# Facebook Messenger (optional)
FB_VERIFY_TOKEN=
FB_PAGE_TOKEN=
